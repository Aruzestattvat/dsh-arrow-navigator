{
  "name": "dsh-arrow-navigator",
  "version": "1.8.1",
  "description": "DSH Web 客户端方向键导航：←/→ 切换对话，↑/↓ 在当前会话的上下对话段之间跳转",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "keyboard",
    "navigation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aruzestattvat/dsh-arrow-navigator.git"
  },
  "homepage": "https://github.com/Aruzestattvat/dsh-arrow-navigator#readme",
  "bugs": {
    "url": "https://github.com/Aruzestattvat/dsh-arrow-navigator/issues"
  },
  "author": "Aruzestattvat",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
